{
    // General Settings
    "layer": "top",
    "position": "top",
    "layer": "top",
    "margin": "10em 20em -10em 20em",
    "padding": "10em 0",
    "spacing": 0,
    // Load Modules
    "include": [
        "~/.config/waybar/settings/quicklinks.jsonc",
        "~/.config/waybar/modules.jsonc",
    ],
    // Modules Left
    "modules-left": [
        "hyprland/workspaces",
        "custom/spotify-text",
        "custom/spotify-icon",
    ],
    // Modules Center
    "modules-center": ["clock", "custom/weather"],
    // Modules Right
    "modules-right": [
        "pulseaudio",
        "backlight",
        "bluetooth",
        "battery",
        "network",
        "tray",
        "custom/exit",
    ],
}
